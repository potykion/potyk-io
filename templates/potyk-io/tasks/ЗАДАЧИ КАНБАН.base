views:
  - type: kanban-view
    name: Table
    filters:
      and:
        - file.ext == "md"
        - 'file.folder == "tasks" || file.folder == "tasks/done" '
        - "!status.isEmpty()"
    groupBy:
      property: status
      direction: ASC
    order:
      - tags
    sort:
      - property: status
        direction: ASC
    columnOrders:
      file.file:
        - Projects/potyk-io-tasks.md
        - Projects/potyk-io-tasks_tasks/msk-food-guide.md
        - Untitled.base
        - msk-food-guide-2026.md
        - Картофельный салат с селёдкой.md
        - Курица с капустой по-азиатски.md
      note.tags:
        - "#potyk-food"
        - Uncategorized
      note.status:
        - idea
        - new
        - wip
        - done
    cardOrders:
      file.file: {}
      note.tags: {}
      note.status:
        Uncategorized:
          - Екат Воспоминания.md
        new:
          - Картофельный салат с селёдкой.md
          - Курица с капустой по-азиатски.md
          - Перенос potyk-io на flask + caddy.md
          - Екат Воспоминания.md
        wip:
          - msk-food-guide-2026.md
          - Музыка 2к26.md
    columnColors:
      file.file: {}
      note.tags: {}
      note.status:
        done: green
        wip: purple
        new: cyan
    groupByProperty: note.status
