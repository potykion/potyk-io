views:
  - type: kanban-view
    name: Table
    filters:
      and:
        - file.ext == "md"
    order:
      - tags
    columnOrders:
      file.file:
        - Projects/potyk-io-tasks.md
        - Projects/potyk-io-tasks_tasks/msk-food-guide.md
        - Untitled.base
        - msk-food-guide-2026.md
        - Картофельный салат с селёдкой.md
        - Курица с капустой по-азиатски.md
      note.tags:
        - "#potyk-food"
        - Uncategorized
      note.status:
        - new
        - wip
        - done
    cardOrders:
      file.file: {}
      note.tags: {}
      note.status:
        Uncategorized:
          - Екат Воспоминания.md
        new:
          - Картофельный салат с селёдкой.md
          - Курица с капустой по-азиатски.md
          - Перенос potyk-io на flask + caddy.md
          - Екат Воспоминания.md
        wip:
          - msk-food-guide-2026.md
          - Музыка 2к26.md
    columnColors:
      file.file: {}
      note.tags: {}
      note.status:
        done: green
        wip: purple
        new: cyan
    groupByProperty: note.status
