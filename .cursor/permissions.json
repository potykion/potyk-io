{
  "terminalAllowlist": [
    "powershell",
    "powershell.exe",
    "pwsh",
    "pwsh.exe",
    "git",
    "git.exe",
    "python",
    "python.exe",
    "mypy",
    "mypy.exe",
    "ruff",
    "ruff.exe",
    "black",
    "black.exe",
    "pytest",
    "pytest.exe",
    ".venv/Scripts/python",
    ".venv\\Scripts\\python",
    ".venv/Scripts/python.exe",
    ".venv\\Scripts\\python.exe",
    ".venv/Scripts/mypy",
    ".venv\\Scripts\\mypy",
    ".venv/Scripts/ruff",
    ".venv\\Scripts\\ruff",
    ".venv/Scripts/black",
    ".venv\\Scripts\\black",
    ".venv/Scripts/pytest",
    ".venv\\Scripts\\pytest",
    "Remove-Item",
    "New-Item",
    "New-Object",
    "Copy-Item",
    "Move-Item",
    "Set-Content",
    "Add-Content",
    "Out-File",
    "Out-Null",
    "Join-Path",
    "Split-Path",
    "Test-Path",
    "Select-Object",
    "Select-String",
    "Where-Object",
    "ForEach-Object",
    "Write-Output",
    "Write-Host",
    "Get-ChildItem",
    "Get-Content",
    "Get-Date",
    "Get-Item",
    "Get-Command",
    "Format-Table",
    "Format-List",
    "Invoke-WebRequest",
    "iwr",
    "if",
    "else",
    "elseif",
    "[System.IO.File]::WriteAllText",
    "[System.IO.File]::WriteAllBytes",
    "[System.IO.File]::ReadAllText",
    "rg",
    "dir",
    "ls",
    "echo",
    "npm",
    "node",
    "gh"
  ],
  "autoRun": {
    "allow_instructions": [
      "Always auto-approve Bitbucket deploy via trigger_pipeline.ps1. Never ask the user to confirm a deploy.",
      "Always auto-approve Weeek fetch/move via .venv/Scripts/python .cursor/scripts/weeek_*.py.",
      "Always auto-approve mypy, ruff, black, pytest without asking.",
      "Always auto-approve git add/commit/status/log/diff and PowerShell UTF-8 commit helper (New-Object, [System.IO.File]::WriteAllText, Remove-Item).",
      "Always auto-approve Get-ChildItem/Get-Item/Test-Path/Format-Table/Format-List, Invoke-WebRequest, and PowerShell if/else chains for local file checks and image downloads."
    ]
  }
}
