# potyk-io reverse proxy
# https://potyk.io (auto HTTPS via Let's Encrypt)

potyk.io {
	encode gzip

	# potyk-food → GitHub Pages
	handle /potyk-food* {
		reverse_proxy https://potykion.github.io {
			header_up Host potykion.github.io
		}
	}

	# potyk-io → :5008
	handle {
		reverse_proxy 127.0.0.1:5008
	}
}
