[Unit]
Description=potyk.io SQLite backup to Yandex Object Storage
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=leybovich-nikita
WorkingDirectory=/home/leybovich-nikita/potyk-io
EnvironmentFile=/home/leybovich-nikita/potyk-io/.env
Environment=BACKUP_PC_NAME=prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/leybovich-nikita/potyk-io/.venv/bin/python -m potyk_io_back.backup_job
StandardOutput=append:/home/leybovich-nikita/potyk-io/logs/backup.log
StandardError=append:/home/leybovich-nikita/potyk-io/logs/backup.error.log
