# potyk-io reverse proxy
# https://potyk.io (auto HTTPS via Let's Encrypt)

potyk.io {
	encode gzip

	# potyk-io → :5008
	handle {
		reverse_proxy 127.0.0.1:5008
	}
}

# 62tattoo admin — SPA (frontend/dist) + API (:8010)
62tattoo.potyk.io {
	encode gzip

	handle_path /media/* {
		root * /home/leybovich-nikita/62tattoo/Картинки/Вставлены
		file_server
	}

	handle /api* {
		reverse_proxy 127.0.0.1:8010
	}

	handle {
		root * /home/leybovich-nikita/62tattoo-web/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
