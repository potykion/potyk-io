# Local only (flask run). Prod uses gunicorn via potyk-io.service.
FLASK_APP=main:create_app
# Generate it via
# python -c 'import secrets; print(secrets.token_hex())'
FLASK_SECRET=
# Telegram bots (long-poll via potyk-tg.service)
# Cloudflare Worker proxy (RF): https://<worker>.workers.dev/bot
TELEGRAM_API_BASE_URL=
# Bots + tokens: instance/telegram_bots.json (gitignored via instance/)
# TELEGRAM_BOTS_FILE=instance/telegram_bots.json
# Example without secrets: potyk_io_back/tg/telegram_bots.example.json
# Legacy single bot (if no bots file):
# TELEGRAM_BOT_TOKEN=
# Yandex Object Storage (S3) — бекап instance/main.db (админка + potyk-io-backup.timer)
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=
YC_S3_BUCKET=potyk-io-backups
# YC_S3_ENDPOINT=https://storage.yandexcloud.net
# YC_S3_REGION=ru-central1
# Optional override for object key hostname (else COMPUTERNAME / HOSTNAME)
# На проде timer ставит BACKUP_PC_NAME=prod через unit
# BACKUP_PC_NAME=
# :)
